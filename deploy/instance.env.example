# One house guide. Copy to instances/<name>.env (never committed) and fill in.
# Which guide (a folder in dist/): family | husbok-palma | husbok-gotland | husbok-<your id> | .  (. = portal + all)
SITE=husbok-palma
# Fills an EMPTY database on first start: houses/<dir>[:prefix]  (family page: the first home without prefix, the rest '<id>-')
SEED=houses/joanmiro87
# Address: BIND 127.0.0.1 behind a reverse proxy (Caddy/nginx with TLS), or an internal IP such as 10.108.0.5
BIND=127.0.0.1
PORT=8081
# Sign-in. Owner sees and edits everything incl. private; editor edits the house book; guest may send requests.
OWNER_PASSWORD=change-me
EDITOR_PASSWORD=
GUEST_PASSWORD=
# 1 = anyone with the address may read the public house book; 0 = everything behind sign-in
PUBLIC=1
# "Ask the house" (optional): an Anthropic API key, billed to you
ANTHROPIC_API_KEY=
# demos only: load invented private rows (costs, tasks …) so the owner pages are not empty
EXAMPLE_PRIVATE=
